{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autoopulence",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Pre-bundled by tools/static-export/build-worker.mjs; uploaded as-is.
  "main": "./worker/dist/index.js",
  "no_bundle": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // Every request goes through the Worker first so www and http can be redirected to https://autoopulence.co.uk.
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "SMTP_FROM_EMAIL": "noreply@autoopulence.co.uk",
    "SMTP_FROM_NAME": "Auto Opulence Website",
    // CRM enquiry bot: "preview" shows it only on the workers.dev preview address, "live" on autoopulence.co.uk too,
    // "off" nowhere.
    "ENQUIRY_BOT": "preview",
    // External uptime pinger (worker/src/uptime-pinger.ts): who gets the "CRM is down" emails. Comma separated.
    "ALERT_EMAILS": "justin@broadlanddigital.co.uk"
  },
  // Every 5 minutes: the external uptime pinger for the CRM.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Remembers what the uptime pinger has already alerted on.
  "kv_namespaces": [{ "binding": "UPTIME_PINGER", "id": "2eee1ee7f3b6496aa0e9e2dc6c0fdf46" }],
  // Live domain: every request for autoopulence.co.uk and www goes to this Worker (DNS records stay as they are;
  // the Worker redirects www and http to https://autoopulence.co.uk). Remove these to hand the domain back.
  "routes": [
    { "pattern": "autoopulence.co.uk/*", "zone_name": "autoopulence.co.uk" },
    { "pattern": "www.autoopulence.co.uk/*", "zone_name": "autoopulence.co.uk" }
  ],
  "observability": { "enabled": true },
  // Keep secrets and variables added in the Cloudflare dashboard when deploying from GitHub
  "keep_vars": true
}
