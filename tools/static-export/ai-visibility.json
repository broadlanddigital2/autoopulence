      "^/locations(/|$)"
    ],
    [
      "Business and trade valeting",
      "^/business-sectors(/|$)"
    ],
    [
      "Guides and advice",
      "^/guides(/|$)"
    ],
    [
      "Case studies",
      "^/case-studies(/|$)"
    ],
    [
      "Blog",
      "^/blog(/|$)"
    ]
  ],
  "otherTitle": "About, contact and other pages"
